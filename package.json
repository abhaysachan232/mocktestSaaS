{
  "name": "coaching-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run lint && next build",
    "audit": "npm audit --audit-level=high",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "security": "npm run lint && npm run typecheck && npm run audit",
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "node --env-file=.env ./node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node --env-file=.env ./node_modules/prisma/build/index.js migrate dev && npm run prisma:generate",
    "prisma:deploy": "node --env-file=.env ./node_modules/prisma/build/index.js migrate deploy",
    "prisma:status": "node --env-file=.env ./node_modules/prisma/build/index.js migrate status",
    "prisma:reset": "node --env-file=.env ./node_modules/prisma/build/index.js migrate reset",
    "prisma:studio": "node --env-file=.env ./node_modules/prisma/build/index.js studio",
    "seed": "tsx --env-file=.env prisma/seed.ts",
    "seed:undo": "tsx --env-file=.env prisma/seed.undo.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-subscript": "^3.30.2",
    "@tiptap/extension-superscript": "^3.30.2",
    "@tiptap/extension-table": "^3.30.2",
    "@tiptap/extension-table-cell": "^3.30.2",
    "@tiptap/extension-table-header": "^3.30.2",
    "@tiptap/extension-table-row": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.1",
    "date-fns": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.18.4",
    "lucide-react": "^0.542.0",
    "mathlive": "^0.110.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.22.0",
    "razorpay": "^2.9.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.80.0",
    "react-hot-toast": "^2.6.0",
    "react-katex": "^3.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
