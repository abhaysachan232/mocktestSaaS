// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  COACHING
  SALES
  MAINTINACE
  ADMIN
}

model User {
  id         String     @id @default(cuid()) // Primary Key
  email      String     @unique
  password   String
  role       Role       @default(STUDENT)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  student    Student?
  coachingId String?
  coaching   Coaching?  @relation(fields: [coachingId], references: [id])
  exams      Exam[]
  questions  Question[]
}

model Student {
  id     String   @id @default(cuid()) // Primary Key
  userId String   @unique
  name   String
  dob    DateTime
  mobile String   @unique
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Coaching {
  id           String  @id @default(cuid()) // Primary Key
  code         String  @unique
  coachingName String
  mobile       String  @unique
  logo         String?
  address      String
  ownerName    String
  idProof      String? //upload id proof doc
  idNumber     String // input id number adhar/pancard
  users        User[]
}

enum CourseName {
  CGL
  SSC
  SSC_GD
  SSC_CGL
  IBPS
  RRB_NTPC
  RRB_GROUP_D
  RRB_JE
  RRB_ALP
  SSC_CHSL
  SSC_NPS
  AGNIVEER
  UP_POLICE_CONSTABLE
  UP_POLICE_SI
  PET
  TET
  CET
}

model Coupon {
  id         String   @id @default(cuid()) // Primary Key
  name       String
  discount   Int //in percent ex : 15, 20
  expiryDate DateTime
}

model Subject {
  id           String        @id @default(cuid())
  name         String        @unique
  topics       Topic[]
  examSubjects ExamSubject[]
  examTopics   ExamTopic[]
  questions    Question[]
}

model Topic {
  id         String      @id @default(cuid())
  subjectId  String
  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name       String
  examTopics ExamTopic[]
  questions  Question[]

  @@unique([subjectId, name])
  @@index([subjectId])
}

model ExamSubject {
  examId    String
  subjectId String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@id([examId, subjectId])
}

model ExamTopic {
  examId    String
  subjectId String
  topicId   String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id])
  topic     Topic   @relation(fields: [topicId], references: [id])

  @@id([examId, topicId])
  @@index([subjectId])
  @@index([topicId])
}

model Exam {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String?
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  examSubjects ExamSubject[]
  examTopics   ExamTopic[]
  tests        Test[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

model Question {
  id            String           @id @default(cuid())
  userId        String?
  user          User?            @relation(fields: [userId], references: [id])
  subjectId     String
  subject       Subject          @relation(fields: [subjectId], references: [id])
  topicId       String
  topic         Topic            @relation(fields: [topicId], references: [id])
  type          QuestionType     @default(SINGLE_CHOICE)
  content       Json
  solution      Json?
  options       QuestionOption[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  testQuestions TestQuestion[]

  @@index([userId])
  @@index([subjectId])
  @@index([topicId])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content    Json
  isCorrect  Boolean  @default(false)

  @@index([questionId])
}

enum TestType {
  PRACTICE
  MOCK
  FULL_LENGTH
  SUBJECT_WISE
  TOPIC_WISE
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Test {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  description     String?
  testType        TestType       @default(MOCK)
  status          TestStatus     @default(DRAFT)
  examId          String
  exam            Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  duration        Int
  totalMarks      Int
  totalQuestions  Int
  negativeMarking Boolean        @default(false)
  negativeMarks   Float?
  publishedAt     DateTime?
  testQuestions   TestQuestion[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([examId])
}

model TestQuestion {
  testId     String
  questionId String
  order      Int
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([testId, questionId])
  @@index([testId, order])
  @@index([questionId])
}
