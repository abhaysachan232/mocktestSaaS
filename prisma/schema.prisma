model Coaching {
  id           String  @id @default(cuid()) // Primary Key
  code         String  @unique
  coachingName String
  logo         String?
  address      String
  ownerName    String
  idProof      String? //upload id proof doc
  idNumber     String // input id number adhar/pancard
  users        User[]
}

enum CourseName {
  CGL
  SSC
  SSC_GD
  SSC_CGL
  IBPS
  RRB_NTPC
  RRB_GROUP_D
  RRB_JE
  RRB_ALP
  SSC_CHSL
  SSC_NPS
  AGNIVEER
  UP_POLICE_CONSTABLE
  UP_POLICE_SI
  PET
  TET
  CET
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Coupon {
  id         String   @id @default(cuid()) // Primary Key
  name       String
  discount   Int //in percent ex : 15, 20
  expiryDate DateTime
}

