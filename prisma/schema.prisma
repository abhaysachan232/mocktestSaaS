// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  COACHING
  SALES
  MAINTINACE
  ADMIN
}

model User {
  id         String    @id @default(cuid()) // Primary Key
  email      String    @unique
  password   String
  role       Role      @default(STUDENT)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  student    Student?
  coachingId String?
  coaching   Coaching? @relation(fields: [coachingId], references: [id])
  exams      Exam[]
}

model Student {
  id     String   @id @default(cuid()) // Primary Key
  userId String   @unique
  name   String
  dob    DateTime
  mobile String   @unique
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Coaching {
  id           String  @id @default(cuid()) // Primary Key
  code         String  @unique
  coachingName String
  mobile       String  @unique
  logo         String?
  address      String
  ownerName    String
  idProof      String? //upload id proof doc
  idNumber     String // input id number adhar/pancard
  users        User[]
}

enum CourseName {
  CGL
  SSC
  SSC_GD
  SSC_CGL
  IBPS
  RRB_NTPC
  RRB_GROUP_D
  RRB_JE
  RRB_ALP
  SSC_CHSL
  SSC_NPS
  AGNIVEER
  UP_POLICE_CONSTABLE
  UP_POLICE_SI
  PET
  TET
  CET
}

model Coupon {
  id         String   @id @default(cuid()) // Primary Key
  name       String
  discount   Int //in percent ex : 15, 20
  expiryDate DateTime
}

model Subject {
  id           String        @id @default(cuid())
  name         String        @unique
  topics       Topic[]
  examSubjects ExamSubject[]
  examTopics   ExamTopic[]
}

model Topic {
  id         String      @id @default(cuid())
  subjectId  String
  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name       String
  examTopics ExamTopic[]
}

model ExamSubject {
  examId    String
  subjectId String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@id([examId, subjectId])
}

model ExamTopic {
  examId    String
  subjectId String
  topicId   String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id])
  topic     Topic   @relation(fields: [topicId], references: [id])

  @@id([examId, topicId])
}

model Exam {
  id             String        @id @default(cuid())
  coachingId     String
  coaching       User          @relation(fields: [coachingId], references: [id], onDelete: Cascade)
  name           String
  examDate       DateTime
  duration       Int
  totalMarks     Float
  totalQuestions Int
  subjects       ExamSubject[]
  topics         ExamTopic[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}
